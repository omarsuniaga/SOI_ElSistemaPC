{
  "name": "sistema-academico-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:safe": "bash scripts/run-build-safe.sh",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:safe": "bash scripts/run-tests-from-tmp.sh",
    "test:sql": "psql \"$DATABASE_URL\" -f supabase/tests/fn_hermes_resolver_caso.test.sql",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "unicode:test": "vitest run --config vitest.unicode.config.mjs",
    "unicode:check": "node tools/unicode-reviewer/revisar-textos.js ./src --dry-run",
    "unicode:review": "node tools/unicode-reviewer/revisar-textos.js ./src",
    "unicode:auto": "node tools/unicode-reviewer/revisar-textos.js ./src --auto-fix"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "supabase": "^2.98.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/supabase-js": "^2.105.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "signature_pad": "^5.1.3",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": ">=1.0.0",
    "@rolldown/binding-linux-x64-gnu": ">=1.0.0"
  }
}
