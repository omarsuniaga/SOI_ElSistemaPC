# Supabase
VITE_SUPABASE_URL=tu_url_de_supabase_aqui
VITE_SUPABASE_ANON_KEY=tu_anon_key_de_supabase_aqui

# Push Notifications (VAPID)
VITE_VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui

# Groq AI (asistente pedagógico)
# La API key vive en Supabase Edge Functions secrets (GROQ_API_KEY),
# no en el frontend.
VITE_GROQ_MODEL=llama-3.1-8b-instant
VITE_WHISPER_MODEL=whisper-large-v3

# Proveedor de IA para desarrollo local: 'groq' (proxy en Supabase, default)
# u 'ollama' (modelo local, sin costo ni internet; requiere `ollama serve`).
# La transcripción de audio (Whisper) no está disponible en modo 'ollama'.
VITE_AI_PROVIDER=groq
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5-coder:7b

# Demo mode (true/false)
VITE_DEMO_MODE=false

# Sentry error tracking (opcional)
# VITE_SENTRY_DSN=tu_sentry_dsn_aqui
