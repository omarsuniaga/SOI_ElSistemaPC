  "normalizer": "CREATE OR REPLACE FUNCTION public.normalizar_tel_rd(raw text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE\nAS $function$\n  SELECT CASE\n    WHEN d ~ '^1(809|829|849)[0-9]{7}$' THEN '+' || d\n    WHEN d ~ '^(809|829|849)[0-9]{7}$'  THEN '+1' || d\n    ELSE NULL\n  END\n  FROM (SELECT regexp_replace(coalesce(raw, ''), '[^0-9]', '', 'g') AS d) x\n$function$\n"
