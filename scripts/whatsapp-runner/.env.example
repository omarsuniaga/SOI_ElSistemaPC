# Copy this file to a protected location (for example /etc/soi/whatsapp-runner.env)
# and replace every value. Never commit the real file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_ANON_KEY=public-anon-key
WHATSAPP_GATEWAY_INTERNAL_KEY=replace-with-a-long-random-secret
WHATSAPP_SESSION_BACKUP_KEY=replace-with-64-hex-characters
WHATSAPP_WEBHOOK_SECRET=replace-with-webhook-secret

# One systemd process per institutional WhatsApp account.
WHATSAPP_INSTANCE_NAME=soi-main
WHATSAPP_AUTH_DIR=/var/lib/soi-whatsapp/soi-main/auth
WHATSAPP_SESSION_BACKUP_DIR=/var/lib/soi-whatsapp/soi-main/backups
WHATSAPP_GATEWAY_HOST=0.0.0.0
WHATSAPP_GATEWAY_PORT=8787
WHATSAPP_ALLOWED_ORIGINS=https://adm.example.org
